{
  "name": "Main Gateway",
  "nodes": [
    {
      "parameters": {
        "path": "gateway/events",
        "httpMethod": "POST",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "Webhook_Gateway",
      "name": "Gateway Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.body.secret}}",
              "operation": "equal",
              "value2": "={{$env.N8N_GATEWAY_SECRET}}"
            },
            {
              "value1": "={{$json.body.event_type}}",
              "operation": "notEmpty"
            }
          ]
        }
      },
      "id": "If_Valid_Signature",
      "name": "Valid Secret + Event?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.body.event_type}}",
              "operation": "equal",
              "value2": "task.created"
            }
          ]
        }
      },
      "id": "If_Task_Created",
      "name": "If task.created?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        760,
        220
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.body.event_type}}",
              "operation": "equal",
              "value2": "task.updated"
            }
          ]
        }
      },
      "id": "If_Task_Updated",
      "name": "If task.updated?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        880,
        260
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.body.event_type}}",
              "operation": "equal",
              "value2": "user.mention"
            }
          ]
        }
      },
      "id": "If_User_Mention",
      "name": "If user.mention?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1010,
        320
      ]
    },
    {
      "parameters": {
        "keepOnlySet": true,
        "values": {
          "string": [
            {
              "name": "chat_id",
              "value": "={{$json.body.chat_id || $env.TELEGRAM_USER_CHAT_ID}}"
            },
            {
              "name": "text",
              "value": "={{\"[task.created]\\n\" + \"Title: \" + ($json.body.payload && $json.body.payload.title ? $json.body.payload.title : \"-\") + \"\\n\" + \"Assignee: \" + ($json.body.payload && $json.body.payload.assignee ? $json.body.payload.assignee : \"-\") + \"\\n\" + \"Link: \" + ($json.body.payload && $json.body.payload.link ? $json.body.payload.link : \"-\")}}"
            }
          ]
        }
      },
      "id": "Set_Telegram_Task_Created",
      "name": "Build Telegram Message (task.created)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [
        1040,
        120
      ]
    },
    {
      "parameters": {
        "keepOnlySet": true,
        "values": {
          "string": [
            {
              "name": "chat_id",
              "value": "={{$json.body.chat_id || $env.TELEGRAM_USER_CHAT_ID}}"
            },
            {
              "name": "text",
              "value": "={{\"[task.updated]\\n\" + \"Title: \" + ($json.body.payload && $json.body.payload.title ? $json.body.payload.title : \"-\") + \"\\n\" + \"Status: \" + ($json.body.payload && $json.body.payload.status ? $json.body.payload.status : \"-\") + \"\\n\" + \"Link: \" + ($json.body.payload && $json.body.payload.link ? $json.body.payload.link : \"-\")}}"
            }
          ]
        }
      },
      "id": "Set_Telegram_Task_Updated",
      "name": "Build Telegram Message (task.updated)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [
        1120,
        200
      ]
    },
    {
      "parameters": {
        "keepOnlySet": true,
        "values": {
          "string": [
            {
              "name": "chat_id",
              "value": "={{$json.body.chat_id || $env.TELEGRAM_USER_CHAT_ID}}"
            },
            {
              "name": "text",
              "value": "={{\"[user.mention]\\n\" + \"Message: \" + ($json.body.payload && $json.body.payload.message ? $json.body.payload.message : \"-\") + \"\\n\" + \"Link: \" + ($json.body.payload && $json.body.payload.link ? $json.body.payload.link : \"-\")}}"
            }
          ]
        }
      },
      "id": "Set_Telegram_User_Mention",
      "name": "Build Telegram Message (user.mention)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [
        1040,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{$env.TELEGRAM_USER_BOT_TOKEN}}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\"chat_id\": $json.chat_id, \"text\": $json.text} }}",
        "options": {}
      },
      "id": "HTTP_Send_Telegram",
      "name": "Send Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1300,
        220
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ {\"ok\": true, \"status\": \"processed\"} }}",
        "options": {}
      },
      "id": "Respond_OK",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.2,
      "position": [
        1540,
        220
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseCode": 401,
        "responseBody": "={{ {\"ok\": false, \"message\": \"invalid secret or event_type\"} }}",
        "options": {}
      },
      "id": "Respond_Unauthorized",
      "name": "Respond Unauthorized",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.2,
      "position": [
        760,
        420
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseCode": 400,
        "responseBody": "={{ {\"ok\": false, \"message\": \"unsupported event_type\"} }}",
        "options": {}
      },
      "id": "Respond_Unsupported",
      "name": "Respond Unsupported",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.2,
      "position": [
        1250,
        420
      ]
    }
  ],
